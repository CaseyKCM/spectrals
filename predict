def lambda_qk(q, k):
    return k*(k + 2) + q*(k + 1)

# Generate unfound predictions
unfound_predictions = []
checked_ratios = set([m['predicted'] for m in matches])

for q1 in range(4):
    for k1 in range(4):
        lam1 = lambda_qk(q1, k1)
        if lam1 == 0:
            continue
        for q2 in range(4):
            for k2 in range(4):
                lam2 = lambda_qk(q2, k2)
                if lam2 == 0 or lam1 <= lam2:
                    continue
                ratio = np.sqrt(lam1 / lam2)
                if 1.2 < ratio < 6 and ratio not in checked_ratios:  # Interesting range
                    unfound_predictions.append({
                        'ratio': ratio,
                        'spectrum': f"√(λ_{q1},{k1}/λ_{q2},{k2})",
                        'q1': q1, 'k1': k1, 'q2': q2, 'k2': k2
                    })

# Remove duplicates and sort
seen = set()
unique_predictions = []
for p in unfound_predictions:
    val = round(p['ratio'], 6)
    if val not in seen:
        seen.add(val)
        unique_predictions.append(p)

unique_predictions.sort(key=lambda x: x['ratio'])

